# Tests are skipped unless these are set.

# GCP folder where test projects are created (numeric folder id).
GCP_TEST_FOLDER_ID=

# Billing account to attach to test projects, in the
# fully-qualified `billingAccounts/{id}` form. Required because
# the GCP APIs we exercise (compute, container, parallelstore)
# refuse to enable without billing.
GCP_TEST_BILLING_ACCOUNT=

# Optional opt-ins for tests that require non-default IAM grants.
# GCP_TEST_SHARED_VPC=1
# GCP_TEST_PARALLELSTORE=1
